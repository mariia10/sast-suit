{
    "$schema": "http://json.schemastore.org/sarif-2.1.0",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
              "driver": {
                "name": "CodeQL",
                "version": "2.8.0", 
                "informationUri": "https://codeql.github.com",
                "rules": [
                  {
                    "id": "example-rule-id",
                    "name": "Example Rule",
                    "shortDescription": {
                      "text": "This is an example rule"
                    },
                    "fullDescription": {
                      "text": "This is the full description of the example rule."
                    },
                    "help": {
                      "text": "Here is some helpful information about this rule.",
                      "markdown": "## Example Rule Help\n\nHere is some helpful information about this rule."
                    }
                
                  }
                ]
                }
            },
            "results": []
        }

    ]
    
    }
